# Normalizar finales de línea en archivos de texto y preservar los PDF.
* text=auto
*.md text eol=lf
*.tex text eol=lf
*.php text eol=lf
*.twig text eol=lf
*.js text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
