<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true">
  <php>
    <server name="APP_ENV" value="test" force="true"/>
    <server name="APP_DEBUG" value="1" force="true"/>
    <server name="SHELL_VERBOSITY" value="-1" force="true"/>
    <server name="KERNEL_CLASS" value="App\Kernel"/>
  </php>
  <testsuites><testsuite name="Huellas"><directory>tests</directory></testsuite></testsuites>
  <source><include><directory>src</directory></include></source>
</phpunit>
