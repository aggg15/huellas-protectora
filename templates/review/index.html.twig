{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">COORDINACIÓN DE ADOPCIONES</p><h1 class="title">Solicitudes recibidas</h1><p class="subtitle is-6">Cada cuestionario es el comienzo de un posible encuentro.</p><div class="animal-grid">{% for application in applications %}<a class="box animal-admin" href="{{ path('review_show',{id:application.id}) }}"><strong>{{ application.animal.code }}</strong><span>{{ application.applicant.name }}</span><span class="tag is-light">{{ application.label }}</span><small>{{ application.submittedAt|date('d/m/Y H:i') }}</small></a>{% else %}<div class="box empty-state">Todavía no hay solicitudes recibidas.</div>{% endfor %}</div>{% endblock %}
