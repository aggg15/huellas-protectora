<div class="box"><h2 class="title is-5">Entrevista</h2>
{% if application.interviewAt %}<p><strong>{{ application.interviewAt|date('d/m/Y H:i') }}</strong></p><p class="mb-4">{{ application.interviewNotes }}</p>{% endif %}
{% if application.status in ['pending','waiting'] %}<form method="post" action="{{ path('review_decide',{id:application.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision-'~application.id) }}"><input type="hidden" name="version" value="{{ application.version }}"><input type="hidden" name="action" value="interview"><div class="field"><label class="label" for="interviewAt">Fecha y hora de la entrevista</label><input class="input" id="interviewAt" name="interviewAt" type="datetime-local" value="{{ data.interviewAt|default(application.interviewAt ? application.interviewAt|date('Y-m-d\\TH:i') : '') }}" required></div><div class="field"><label class="label" for="interviewNotes">Lugar, canal u observaciones</label><textarea class="textarea" id="interviewNotes" name="interviewNotes" required maxlength="4000">{{ data.interviewNotes|default(application.interviewNotes) }}</textarea></div><button class="button is-primary is-outlined">Guardar entrevista</button></form>{% endif %}</div>
<div class="box"><h2 class="title is-5">Decisión de adopción</h2><p class="mb-4">{{ application.label }}</p>
{% if application.status == 'pending' %}<form class="mb-4" method="post" action="{{ path('review_decide',{id:application.id}) }}" data-controller="confirmation" data-action="submit->confirmation#ask" data-confirmation-message-value="¿Aprobar esta candidatura y reservar el animal? Las demás quedarán en espera."><input type="hidden" name="_token" value="{{ csrf_token('decision-'~application.id) }}"><input type="hidden" name="version" value="{{ application.version }}"><input type="hidden" name="action" value="approve"><button class="button is-primary">Aprobar y reservar</button></form>{% endif %}
{% if application.status in ['pending','waiting','approved'] %}<form method="post" action="{{ path('review_decide',{id:application.id}) }}" data-controller="confirmation" data-action="submit->confirmation#ask" data-confirmation-message-value="¿Confirmar esta decisión con el motivo indicado?"><input type="hidden" name="_token" value="{{ csrf_token('decision-'~application.id) }}"><input type="hidden" name="version" value="{{ application.version }}"><input type="hidden" name="action" value="{{ application.status == 'approved' ? 'release' : 'reject' }}"><div class="field"><label class="label" for="reason">Motivo obligatorio</label><textarea class="textarea" id="reason" name="reason" required maxlength="4000">{{ data.reason|default('') }}</textarea></div><button class="button is-danger is-light">{{ application.status == 'approved' ? 'Liberar reserva fallida' : 'Rechazar solicitud' }}</button></form>{% endif %}
{% if application.reason %}<p class="mt-4"><strong>Motivo:</strong> {{ application.reason }}</p>{% endif %}{% if application.decidedBy %}<p class="help mt-3">Decisión de {{ application.decidedBy.name }}, {{ application.decidedAt|date('d/m/Y H:i') }}.</p>{% endif %}</div>
