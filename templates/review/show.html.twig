{% extends 'base.html.twig' %}
{% block body %}<a class="back-link" href="{{ path('review_list') }}">← Volver a solicitudes</a><div class="page-heading"><div><p class="eyebrow">CANDIDATURA PARA {{ application.animal.code }}</p><h1 class="title">{{ application.applicant.name }}</h1><p>{{ application.applicant.email }}</p></div><span class="tag is-medium is-light">{{ application.label }}</span></div>{% include 'partials/errors.html.twig' %}
<div class="detail-grid"><section class="box"><h2 class="title is-5">Cuestionario de adopción</h2>{% for caption,value in {'Vivienda':application.housing,'Experiencia':application.experience,'Disponibilidad':application.availability} %}<div class="review"><h3 class="label">{{ caption }}</h3><p>{{ value }}</p></div>{% endfor %}</section><aside>{% block decisions %}<div class="box"><h2 class="title is-5">Estado de la solicitud</h2><p>{{ application.label }}</p></div>{% endblock %}</aside></div>{% endblock %}
