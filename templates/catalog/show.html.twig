{% extends 'base.html.twig' %}
{% block title %}{{ animal.code }} · Adopta con Huellas{% endblock %}
{% block body %}<a class="back-link" href="{{ path('home') }}#animales">← Volver a los animales</a><div class="detail-grid"><div class="photo-gallery">{% for photo in photos %}<img src="{{ path('photo',{id:photo.id}) }}" alt="{{ animal.code }}, fotografía {{ loop.index }}">{% endfor %}</div><section class="box"><p class="eyebrow">UNA HISTORIA QUE PUEDE SEGUIR CONTIGO</p><h1 class="title">{{ animal.code }}</h1><div class="tags"><span class="tag is-success is-light">Disponible para adopción</span>{% if animal.fostered %}<span class="tag is-warning is-light">En acogida</span>{% endif %}</div><dl class="facts"><dt>Especie</dt><dd>{{ animal.species == 'dog' ? 'Perro' : 'Gato' }}</dd><dt>Edad aproximada</dt><dd>{{ animal.ageMonths }} meses</dd><dt>Tamaño</dt><dd>{{ {small:'Pequeño',medium:'Mediano',large:'Grande'}[animal.size] }}</dd></dl><p>Adoptar implica acompañar, cuidar y ofrecer un hogar. Conoceremos tu situación para buscar el mejor encuentro.</p>{% block application_action %}{% endblock %}</section></div>{% endblock %}
