{% extends 'base.html.twig' %}
{% block body %}
<section class="catalog-hero"><div><p class="eyebrow">PEQUEÑOS ENCUENTROS, GRANDES COMIENZOS</p><h1 class="title">Tu compañero<br>te está esperando.</h1><p class="subtitle">Conoce a los perros y gatos de Huellas que buscan<br class="desktop-only"> una familia con la que compartir su vida.</p><a class="button is-primary" href="#animales">Conocer a los animales <span aria-hidden="true">&nbsp;↗</span></a></div><div class="hero-note"><span class="hero-paw" aria-hidden="true">✿</span><strong>Una nueva oportunidad.</strong><span>Una vida compartida.</span><div class="little-line"></div><p>Adoptar es dar tiempo,<br>cuidado y un hogar.</p></div></section>
<section id="animales"><div class="page-heading"><div><p class="eyebrow">ENCUENTRA TU COMPAÑERO</p><h2 class="title is-3">Historias que buscan hogar</h2></div><span class="count-label">{{ items|length }} {{ items|length == 1 ? 'animal disponible' : 'animales disponibles' }}</span></div>
<form class="filter-bar box" method="get" action="{{ path('home') }}" aria-label="Filtrar animales">
<div class="field"><label class="label" for="filter-species">Especie</label><div class="select is-fullwidth"><select id="filter-species" name="species"><option value="">Todas las especies</option><option value="dog" {{ filters.species == 'dog' ? 'selected' }}>Perros</option><option value="cat" {{ filters.species == 'cat' ? 'selected' }}>Gatos</option></select></div></div>
<div class="field"><label class="label" for="filter-size">Tamaño</label><div class="select is-fullwidth"><select id="filter-size" name="size"><option value="">Todos los tamaños</option>{% for value,label in {small:'Pequeño',medium:'Mediano',large:'Grande'} %}<option value="{{ value }}" {{ filters.size == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div></div>
<div class="field"><label class="label" for="filter-age">Edad</label><div class="select is-fullwidth"><select id="filter-age" name="age"><option value="">Todas las edades</option>{% for value,label in {young:'Menos de un año',adult:'De 1 a 6 años',senior:'7 años o más'} %}<option value="{{ value }}" {{ filters.age == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div></div>
<button class="button is-primary">Filtrar</button><a class="clear-link" href="{{ path('home') }}#animales">Limpiar</a></form>
{% include 'partials/errors.html.twig' %}
<div class="animal-grid">{% for item in items %}{% set animal = item.animal %}<article class="card animal-card"><a href="{{ path('public_animal',{id:animal.id}) }}" aria-label="Conocer a {{ animal.code }}"><div class="card-image">{% if item.photo %}<img src="{{ path('photo',{id:item.photo.id}) }}" alt="{{ animal.species == 'dog' ? 'Perro' : 'Gato' }} {{ animal.code }}" loading="lazy">{% else %}<div class="photo-placeholder" aria-hidden="true">✿</div>{% endif %}{% if animal.fostered %}<span class="tag foster-tag">En acogida</span>{% endif %}</div><div class="card-content"><p class="eyebrow">{{ animal.species == 'dog' ? 'PERRO' : 'GATO' }}</p><h3 class="title is-5">{{ animal.code }}</h3><p>{{ animal.ageMonths }} meses · {{ {small:'Pequeño',medium:'Mediano',large:'Grande'}[animal.size] }}</p><span class="meet-link">Conoce su ficha <span aria-hidden="true">↗</span></span></div></a></article>{% else %}<div class="box empty-state"><h3 class="title is-5">Hoy no hay coincidencias</h3><p>Prueba con otros filtros para encontrar animales que estén buscando hogar.</p><a href="{{ path('home') }}">Ver todos los animales</a></div>{% endfor %}</div></section>
{% endblock %}
