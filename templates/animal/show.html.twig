{% extends 'base.html.twig' %}
{% block body %}<a class="back-link" href="{{ path('admin_animals') }}">← Volver al refugio</a><div class="page-heading"><div><p class="eyebrow">FICHA DEL ANIMAL</p><h1 class="title">{{ animal.code }}</h1></div><span class="tag is-medium is-light">{{ {quarantine:'En cuarentena',available:'Disponible',reserved:'Reservado',adopted:'Adoptado'}[animal.status] }}</span></div>
<div class="detail-grid"><div><div class="photo-gallery">{% for photo in photos %}<img src="{{ path('photo',{id:photo.id}) }}" alt="Fotografía de {{ animal.code }}" loading="lazy">{% endfor %}</div><div class="box"><h2 class="title is-5">Su historia comienza aquí</h2><dl class="facts"><dt>Especie</dt><dd>{{ animal.species == 'dog' ? 'Perro' : 'Gato' }}</dd><dt>Edad aproximada</dt><dd>{{ animal.ageMonths }} meses</dd><dt>Tamaño</dt><dd>{{ {small:'Pequeño',medium:'Mediano',large:'Grande'}[animal.size] }}</dd><dt>Recepción</dt><dd>{{ animal.receivedAt|date('d/m/Y H:i') }}</dd><dt>Fin de cuarentena</dt><dd>{{ animal.releaseAt|date('d/m/Y H:i') }}</dd></dl><p>{{ animal.origin }}</p></div></div>
<aside><div class="box"><h2 class="title is-5">Revisiones veterinarias</h2>{% for review in reviews %}<article class="review"><strong>{{ review.reviewedAt|date('d/m/Y H:i') }}</strong><p>{{ review.notes }}</p><small>{{ review.veterinarian.name }}</small></article>{% else %}<p>Aún no hay revisiones registradas.</p>{% endfor %}</div>
{% if is_granted('ROLE_VET') %}<div class="box"><h2 class="title is-5">Registrar revisión</h2>{% include 'partials/errors.html.twig' %}<form method="post" action="{{ path('animal_review',{id:animal.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('review-'~animal.id) }}"><div class="field"><label class="label" for="reviewedAt">Fecha y hora</label><input class="input" id="reviewedAt" name="reviewedAt" type="datetime-local" value="{{ 'now'|date('Y-m-d\\TH:i') }}" required></div><div class="field"><label class="label" for="notes">Observaciones</label><textarea class="textarea" id="notes" name="notes" maxlength="5000" required></textarea></div><button class="button is-primary">Guardar revisión</button></form></div>{% endif %}</aside></div>{% endblock %}
