{% extends 'base.html.twig' %}
{% block body %}<div class="page-heading"><div><p class="eyebrow">GESTIÓN DEL REFUGIO</p><h1 class="title">Nuestros animales</h1><p class="subtitle is-6">Fichas, cuarentena y cuidados veterinarios.</p></div>{% if is_granted('ROLE_VOLUNTEER') %}<a class="button is-primary" href="{{ path('animal_new') }}">Registrar llegada</a>{% endif %}</div>
<div class="animal-grid">{% for animal in animals %}<a class="box animal-admin" href="{{ path('animal_show',{id:animal.id}) }}"><strong>{{ animal.code }}</strong><span>{{ animal.species == 'dog' ? 'Perro' : 'Gato' }} · {{ animal.ageMonths }} meses</span><span class="tag {{ animal.status == 'quarantine' ? 'is-warning' : 'is-success' }} is-light">{{ {quarantine:'En cuarentena',available:'Disponible',reserved:'Reservado',adopted:'Adoptado'}[animal.status] }}</span></a>{% else %}<div class="box empty-state"><h2 class="title is-5">Todavía no hay fichas</h2><p>Registra la primera llegada para comenzar a cuidar de su historia.</p></div>{% endfor %}</div>{% endblock %}
