{% extends 'base.html.twig' %}
{% block body %}<a class="back-link" href="{{ path('admin_animals') }}">← Volver al refugio</a><h1 class="title">Registrar una llegada</h1><p class="subtitle is-6">El primer paso hacia una nueva oportunidad.</p>
<div class="box form-wide">{% include 'partials/errors.html.twig' %}<form id="animal_form" method="post" enctype="multipart/form-data" data-controller="photos">
<input type="hidden" name="_token" value="{{ csrf_token('animal_new') }}">
<div class="columns"><div class="column field"><label class="label" for="species">Especie</label><div class="select is-fullwidth"><select id="species" name="species" required><option value="">Selecciona</option>{% for value,label in {dog:'Perro',cat:'Gato'} %}<option value="{{ value }}" {{ data.species|default('') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div></div>
<div class="column field"><label class="label" for="size">Tamaño</label><div class="select is-fullwidth"><select id="size" name="size" required><option value="">Selecciona</option>{% for value,label in {small:'Pequeño',medium:'Mediano',large:'Grande'} %}<option value="{{ value }}" {{ data.size|default('') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div></div></div>
<div class="columns"><div class="column field"><label class="label" for="ageMonths">Edad aproximada en meses</label><input class="input" id="ageMonths" name="ageMonths" type="number" min="0" max="600" value="{{ data.ageMonths|default('') }}" required></div>
<div class="column field"><label class="label" for="receivedAt">Fecha y hora de recepción</label><input class="input" id="receivedAt" name="receivedAt" type="datetime-local" value="{{ data.receivedAt|default('now'|date('Y-m-d\\TH:i')) }}" required><p class="help">Hora de Madrid. La cuarentena dura diez días completos.</p></div></div>
<div class="field"><label class="label" for="origin">Procedencia</label><textarea class="textarea" id="origin" name="origin" maxlength="1000" required>{{ data.origin|default('') }}</textarea></div>
<div class="field"><label class="label" for="photos">Fotografías</label><input class="input" id="photos" name="photos[]" type="file" accept="image/jpeg,image/png,image/webp" multiple required data-action="change->photos#preview"><p class="help">De una a seis fotos reales JPEG, PNG o WebP, hasta 5 MiB cada una. Si corriges un error, vuelve a seleccionarlas.</p><div class="photo-preview" data-photos-target="preview"></div></div>
<button class="button is-primary">Guardar ficha</button></form></div>{% endblock %}
