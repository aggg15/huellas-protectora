{% extends 'base.html.twig' %}
{% block body %}<a class="back-link" href="{{ path('home') }}">← Volver al catálogo</a><p class="eyebrow">CONOZCÁMONOS UN POCO MEJOR</p><h1 class="title">Solicitud para {{ animal.code }}</h1><p class="subtitle is-6">Tus respuestas ayudarán a la coordinadora a valorar este encuentro.</p><div class="box form-wide">{% include 'partials/errors.html.twig' %}<form method="post" data-controller="questionnaire"><input type="hidden" name="_token" value="{{ csrf_token('application-'~animal.id) }}">
{% for key,caption in {housing:'¿Cómo es tu vivienda y quiénes conviven en ella?',experience:'¿Qué experiencia tienes con animales?',availability:'¿Qué disponibilidad diaria tienes para sus cuidados?'} %}<div class="field"><label class="label" for="{{ key }}">{{ caption }}</label><textarea class="textarea" id="{{ key }}" name="{{ key }}" maxlength="4000" required data-action="input->questionnaire#update">{{ attribute(data,key)|default('') }}</textarea></div>{% endfor %}
<p class="help mb-4" data-questionnaire-target="status" aria-live="polite">Completa las tres respuestas. Si no tienes experiencia previa, indícalo.</p><button class="button is-primary">Enviar solicitud</button></form></div>{% endblock %}
