{% extends 'base.html.twig' %}
{% block body %}<p class="eyebrow">TU CAMINO HACIA LA ADOPCIÓN</p><h1 class="title">Mis solicitudes</h1><p class="subtitle is-6">Las solicitudes pendientes, en espera y aprobadas cuentan para el límite de dos.</p>
{% for application in applications %}<article class="box"><div class="page-heading"><h2 class="title is-5">{{ application.animal.code }}</h2><span class="tag is-light">{{ application.label }}</span></div><p>Presentada el {{ application.submittedAt|date('d/m/Y H:i') }}</p>{% if application.interviewAt %}<p><strong>Entrevista:</strong> {{ application.interviewAt|date('d/m/Y H:i') }}</p>{% endif %}{% if application.reason %}<p><strong>Motivo:</strong> {{ application.reason }}</p>{% endif %}</article>{% else %}<div class="box empty-state"><h2 class="title is-5">Todavía no has enviado solicitudes</h2><p class="mb-4">Conoce a los animales disponibles y encuentra a tu compañero.</p><a class="button is-primary" href="{{ path('home') }}">Ver animales</a></div>{% endfor %}{% endblock %}
