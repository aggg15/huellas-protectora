{% extends 'base.html.twig' %}

{% block title %}Mis solicitudes · Huellas{% endblock %}

{% block body %}
<div class="page-heading">
  <div>
    <p class="eyebrow">MI CUENTA</p>
    <h1 class="title">Mis solicitudes de adopción</h1>
    <p class="subtitle is-6">Tienes {{ openCount }} de {{ maxOpen }} solicitudes abiertas.</p>
  </div>
  <a class="button is-primary is-outlined" href="{{ path('public_catalog') }}">Ver animales en adopción</a>
</div>

{% if applications is empty %}
  <div class="box empty-state">
    <h2 class="title is-5">Todavía no has enviado solicitudes</h2>
    <p>Consulta el catálogo y abre la ficha del animal que quieras adoptar para enviar tu solicitud.</p>
  </div>
{% else %}
  <div class="table-container box">
    <table class="table is-fullwidth">
      <thead>
        <tr>
          <th scope="col">Animal</th>
          <th scope="col">Fecha de envío</th>
          <th scope="col">Estado</th>
          <th scope="col">Detalle / Seguimiento</th>
        </tr>
      </thead>
      <tbody>
        {% for application in applications %}
          {% set tagClass = {
            'pending': 'is-info',
            'waiting': 'is-warning',
            'approved': 'is-success',
            'rejected': 'is-danger',
            'cancelled': 'is-dark',
            'formalized': 'is-primary'
          }[application.status]|default('is-light') %}
          <tr>
            <td><strong>{{ application.animal.code }}</strong></td>
            <td>{{ application.submittedAt|date('d/m/Y H:i', 'Europe/Madrid') }}</td>
            <td><span class="tag is-light {{ tagClass }}">{{ application.statusLabel }}</span></td>
            <td class="is-size-7">
              {% if application.status == 'formalized' %}
                {% set adoption = adoptions[application.id] ?? null %}
                <span><strong>¡Adopción formalizada!</strong>{% if adoption %} Entrega del {{ adoption.deliveredAt|date('d/m/Y', 'Europe/Madrid') }}. <a href="{{ path('adoption_contract', {id: adoption.id}) }}">Ver contrato {{ adoption.contractNumber }}</a>{% endif %}</span>
              {% elseif application.status == 'approved' %}
                <span class="has-text-success"><strong>¡Animal reservado para ti!</strong> La protectora contactará contigo para formalizar la adopción.</span>
              {% elseif application.status == 'waiting' %}
                <span class="has-text-warning-dark">En lista de espera mientras se valora la reserva del animal.</span>
              {% elseif application.status == 'rejected' %}
                <span class="has-text-danger">Motivo: {{ application.rejectionReason }}</span>
              {% elseif application.status == 'cancelled' %}
                <span class="has-text-grey-dark">Motivo: {{ application.cancellationReason|default('Sin motivo registrado.') }}</span>
              {% elseif application.hasInterview %}
                <span>Entrevista programada: {{ application.interviewAt|date('d/m/Y H:i', 'Europe/Madrid') }}</span>
              {% else %}
                <span class="has-text-grey">Pendiente de revisión por coordinación.</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
