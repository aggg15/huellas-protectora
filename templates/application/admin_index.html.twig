{% extends 'base.html.twig' %}

{% block title %}Solicitudes recibidas · Huellas{% endblock %}

{% block body %}
<div class="page-heading">
  <div>
    <p class="eyebrow">COORDINACIÓN DE ADOPCIONES</p>
    <h1 class="title">Solicitudes recibidas</h1>
    <p class="subtitle is-6">Candidaturas presentadas con su cuestionario completo.</p>
  </div>
</div>

{% if applications is empty %}
  <div class="box empty-state">
    <h2 class="title is-5">No hay solicitudes recibidas</h2>
    <p>Las solicitudes enviadas desde la web pública aparecerán aquí.</p>
  </div>
{% else %}
  <div class="table-container box">
    <table class="table is-fullwidth is-hoverable">
      <thead><tr><th scope="col">Animal</th><th scope="col">Solicitante</th><th scope="col">Fecha de envío</th><th scope="col">Estado</th><th scope="col"><span class="is-sr-only">Acciones</span></th></tr></thead>
      <tbody>
        {% for application in applications %}
          <tr>
            <td><strong>{{ application.animal.code }}</strong></td>
            <td>{{ application.applicant.name }}</td>
            <td>{{ application.submittedAt|date('d/m/Y H:i', 'Europe/Madrid') }}</td>
            <td><span class="tag is-light {{ application.open ? 'is-info' : '' }}">{{ application.statusLabel }}</span></td>
            <td><a href="{{ path('admin_application_show', {id: application.id}) }}">Ver solicitud<span class="is-sr-only"> de {{ application.applicant.name }} para {{ application.animal.code }}</span></a></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
