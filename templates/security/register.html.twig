{% extends 'base.html.twig' %}
{% block body %}<section class="form-card box"><p class="eyebrow">EL PRIMER PASO HACIA LA ADOPCIÓN</p><h1 class="title is-3">Crea tu cuenta</h1><p class="mb-4">Podrás presentar hasta dos solicitudes abiertas.</p>{% include 'partials/errors.html.twig' %}<form method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('register') }}">
<div class="field"><label class="label" for="name">Nombre</label><input class="input" id="name" name="name" value="{{ data.name|default('') }}" maxlength="100" autocomplete="name" required></div>
<div class="field"><label class="label" for="email">Email</label><input class="input" id="email" name="email" type="email" value="{{ data.email|default('') }}" maxlength="180" autocomplete="username" required></div>
<div class="field"><label class="label" for="password">Contraseña</label><input class="input" id="password" name="password" type="password" minlength="12" maxlength="200" autocomplete="new-password" required><p class="help">Al menos 12 caracteres.</p></div>
<div class="field"><label class="label" for="confirmation">Repite la contraseña</label><input class="input" id="confirmation" name="confirmation" type="password" autocomplete="new-password" required></div><button class="button is-primary is-fullwidth">Crear cuenta</button></form></section>{% endblock %}
