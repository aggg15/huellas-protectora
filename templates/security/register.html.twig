{% extends 'base.html.twig' %}
{% block title %}Crear cuenta · Huellas{% endblock %}
{% block body %}
<section class="form-card box">
  <p class="eyebrow">CUENTA DE SOLICITANTE</p>
  <h1 class="title is-3">Crea tu cuenta</h1>
  <p class="mb-4 has-text-grey">La necesitas para enviar solicitudes de adopción. Consultar el catálogo no requiere cuenta.</p>
  {% include 'partials/errors.html.twig' %}
  <form method="post" action="{{ path('register') }}" data-turbo="false">
    <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
    <div class="field"><label class="label" for="name">Nombre</label><input class="input" id="name" name="name" value="{{ data.name|default('') }}" maxlength="100" autocomplete="name" required{% if errors.name is defined %} aria-invalid="true" aria-describedby="error-name"{% endif %}></div>
    <div class="field"><label class="label" for="email">Email</label><input class="input" type="email" id="email" name="email" value="{{ data.email|default('') }}" maxlength="180" autocomplete="email" required{% if errors.email is defined %} aria-invalid="true" aria-describedby="error-email"{% endif %}></div>
    <div class="field"><label class="label" for="password">Contraseña</label><input class="input" type="password" id="password" name="password" minlength="12" autocomplete="new-password" required aria-describedby="password-help{% if errors.password is defined %} error-password{% endif %}"><p class="help" id="password-help">Mínimo 12 caracteres.</p></div>
    <div class="field"><label class="label" for="passwordConfirmation">Repite la contraseña</label><input class="input" type="password" id="passwordConfirmation" name="passwordConfirmation" autocomplete="new-password" required{% if errors.passwordConfirmation is defined %} aria-invalid="true" aria-describedby="error-passwordConfirmation"{% endif %}></div>
    <button class="button is-primary is-fullwidth">Crear cuenta</button>
  </form>
  <p class="mt-4 is-size-7">¿Ya tienes cuenta? <a href="{{ path('login') }}">Accede</a></p>
</section>
{% endblock %}
